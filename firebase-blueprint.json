{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences for the Skeena Steelhead Tracker application",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the user",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL of the user",
          "maxLength": 500
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider used by the user",
          "enum": ["google", "apple", "facebook", "local", "password"]
        },
        "riverRole": {
          "type": "string",
          "description": "River role or affiliation of the user",
          "enum": ["angler", "guide", "biologist", "conservationist", "resident", "guest"]
        },
        "preferredTributary": {
          "type": "string",
          "description": "User's preferred Skeena watershed tributary",
          "maxLength": 50
        },
        "alertThreshold": {
          "type": "number",
          "description": "Tyee index or escapement alert threshold"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format",
          "maxLength": 50
        }
      },
      "required": ["userId", "displayName", "provider", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Designated administrator permissions record",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "description": "UID or normalized email identifier of the administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Email address of the administrator",
          "maxLength": 150
        },
        "addedBy": {
          "type": "string",
          "description": "Email or UID of the admin who granted access",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of admin registration",
          "maxLength": 50
        }
      },
      "required": ["adminId", "email", "createdAt"]
    },
    "SavedScenario": {
      "title": "SavedScenario",
      "description": "Saved What-If sandbox simulation scenario",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the scenario",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of scenario owner",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the simulation scenario",
          "maxLength": 100
        },
        "multiplier": {
          "type": "number",
          "description": "Multiplier factor applied to run"
        },
        "timingShiftDays": {
          "type": "number",
          "description": "Days timing is shifted"
        },
        "notes": {
          "type": "string",
          "description": "Personal simulation notes",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "title", "multiplier", "timingShiftDays", "createdAt", "updatedAt"]
    },
    "FieldObservation": {
      "title": "FieldObservation",
      "description": "User field notes and river observations for specific dates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of observation note",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of observer",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Observation date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "tributary": {
          "type": "string",
          "description": "Tributary or Skeena section observed",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "description": "Field notes or water conditions",
          "maxLength": 1000
        },
        "waterCondition": {
          "type": "string",
          "description": "Water clarity and height",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update",
          "maxLength": 50
        }
      },
      "required": ["id", "userId", "date", "tributary", "notes", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public angler directory profile with zero PII for username search and friend invitations",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the user",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name / handle of the angler",
          "maxLength": 100
        },
        "riverRole": {
          "type": "string",
          "description": "River role or affiliation",
          "enum": ["angler", "guide", "biologist", "conservationist", "resident", "guest"]
        },
        "preferredTributary": {
          "type": "string",
          "description": "Primary Skeena tributary",
          "maxLength": 50
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of profile update",
          "maxLength": 50
        }
      },
      "required": ["userId", "displayName", "riverRole", "updatedAt"]
    },
    "SharedFieldNote": {
      "title": "SharedFieldNote",
      "description": "Field note shared privately with selected user IDs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique note identifier",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "UID of the note owner",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 100
        },
        "authorRole": {
          "type": "string",
          "description": "River role of the author",
          "maxLength": 50
        },
        "authorPhotoURL": {
          "type": "string",
          "description": "Author avatar photo",
          "maxLength": 500
        },
        "sharedWithUserIds": {
          "type": "array",
          "description": "List of user UIDs granted private access to this note",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string",
          "description": "Field log title",
          "maxLength": 100
        },
        "tributary": {
          "type": "string",
          "description": "Tributary observed",
          "maxLength": 50
        },
        "date": {
          "type": "string",
          "description": "Observation date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "time": {
          "type": "string",
          "description": "Observation time",
          "maxLength": 10
        },
        "waterClarity": {
          "type": "string",
          "description": "Water clarity category",
          "maxLength": 50
        },
        "waterTempC": {
          "type": "number",
          "description": "Water temperature in Celsius"
        },
        "waterLevelGauge": {
          "type": "string",
          "description": "Water level or gauge observation",
          "maxLength": 50
        },
        "flyPattern": {
          "type": "string",
          "description": "Fly patterns or tackle used",
          "maxLength": 100
        },
        "steelheadHooked": {
          "type": "number",
          "description": "Number of steelhead hooked"
        },
        "steelheadLanded": {
          "type": "number",
          "description": "Number of steelhead landed"
        },
        "notes": {
          "type": "string",
          "description": "Angler notes and river observations",
          "maxLength": 2000
        },
        "photos": {
          "type": "array",
          "description": "Attached photos",
          "items": {
            "type": "string"
          }
        },
        "isGpsCloaked": {
          "type": "boolean",
          "description": "Whether exact GPS coordinates are hidden from shared recipients"
        },
        "poolName": {
          "type": "string",
          "description": "Specific pool name (if not cloaked)",
          "maxLength": 100
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate"
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update",
          "maxLength": 50
        }
      },
      "required": ["id", "authorId", "authorName", "sharedWithUserIds", "title", "tributary", "date", "notes", "createdAt", "updatedAt"]
    },
    "UsageMetric": {
      "title": "UsageMetric",
      "description": "Daily site activity and feature usage metrics summary for root admin",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Metric date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "totalVisits": {
          "type": "number",
          "description": "Total visits or sessions for the day"
        },
        "tyeeQueries": {
          "type": "number",
          "description": "Number of Tyee test fishery queries"
        },
        "simulatorRuns": {
          "type": "number",
          "description": "Number of run simulator calculations"
        },
        "dossierDecryptions": {
          "type": "number",
          "description": "Number of encrypted dossier decryptions"
        }
      },
      "required": ["date", "totalVisits"]
    },
    "SiteEvent": {
      "title": "SiteEvent",
      "description": "Real-time telemetry event across the portal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event ID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Event type identifier",
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "description": "Event category",
          "maxLength": 50
        },
        "action": {
          "type": "string",
          "description": "Description of action",
          "maxLength": 250
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of event",
          "maxLength": 50
        }
      },
      "required": ["id", "type", "category", "action", "timestamp"]
    }
  },
  "firestore": {
    "/usageMetrics/{metricId}": {
      "schema": {
        "$ref": "#/entities/UsageMetric"
      },
      "description": "Stores daily usage metrics summaries for administrative oversight."
    },
    "/siteEvents/{eventId}": {
      "schema": {
        "$ref": "#/entities/SiteEvent"
      },
      "description": "Stores real-time interaction and telemetry event trail."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Stores administrator authorization records and allowed admin accounts."
    },
    "/publicProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/PublicProfile"
      },
      "description": "Stores non-PII angler public profiles for username search and friend invitations."
    },
    "/sharedFieldNotes/{noteId}": {
      "schema": {
        "$ref": "#/entities/SharedFieldNote"
      },
      "description": "Stores field notes shared privately with selected user IDs."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profiles with authentication provider and personalized river preferences."
    },
    "/users/{userId}/savedScenarios/{scenarioId}": {
      "schema": {
        "$ref": "#/entities/SavedScenario"
      },
      "description": "Stores user custom What-If run simulations."
    },
    "/users/{userId}/fieldObservations/{observationId}": {
      "schema": {
        "$ref": "#/entities/FieldObservation"
      },
      "description": "Stores user river notes and field log observations."
    }
  }
}
