<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route API requests to the Hostinger Gemini PHP proxy
  RewriteRule ^api/gemini/ask/?$ /api/gemini.php?action=ask [L,QSA]
  RewriteRule ^api/gemini/analyze/?$ /api/gemini.php?action=analyze [L,QSA]

  # 2. SPA Fallback: Route all other non-file requests to React index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP compression for blazing fast performance on Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security and cache headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
